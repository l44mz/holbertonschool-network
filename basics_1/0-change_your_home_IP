#!/usr/bin/env bash
# Configures localhost and facebook.com address mappings in /etc/hosts

HOSTS_FILE="/etc/hosts"

if [ "$EUID" -ne 0 ]; then
    echo "Please run this script as root."
    exit 1
fi

sed -i -E \
    '/^[[:space:]]*127\.0\.0\.1[[:space:]]+localhost([[:space:]]|$)/s/127\.0\.0\.1/127.0.0.2/' \
    "$HOSTS_FILE"

if ! grep -qE '^[[:space:]]*127\.0\.0\.2[[:space:]]+localhost([[:space:]]|$)' "$HOSTS_FILE"; then
    echo "127.0.0.2 localhost" >> "$HOSTS_FILE"
fi

sed -i -E '/^[[:space:]]*[0-9.]+[[:space:]]+facebook\.com([[:space:]]|$)/d' "$HOSTS_FILE"
echo "8.8.8.8 facebook.com" >> "$HOSTS_FILE"
